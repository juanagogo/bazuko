{
  "name": "bazuko-servicios",
  "version": "0.1.0",
  "private": true,
  "description": "Cuentas y funciones sociales del port C++ de Bazuko (Cognito, Lambda, DynamoDB, API Gateway)",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --outputs-file salida.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.693.0",
    "@aws-sdk/lib-dynamodb": "3.693.0",
    "aws-jwt-verify": "4.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/node": "22.9.0",
    "aws-cdk": "2.170.0",
    "aws-cdk-lib": "2.170.0",
    "constructs": "10.4.2",
    "esbuild": "0.24.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
